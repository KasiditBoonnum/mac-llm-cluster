# Environment variables template
# Copy to .env and fill in values

# Discord ChatOps
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Slack ChatOps
SLACK_BOT_TOKEN=your_slack_bot_token_here

# LLM Gateway API Key
LLM_API_KEY=your_api_key_here

# Cluster nodes (override if not using mDNS)
NODE1_HOST=llm-01.local
NODE2_HOST=llm-02.local
NODE3_HOST=llm-03.local

NODE1_IP=192.168.10.11
NODE2_IP=192.168.10.12
NODE3_IP=192.168.10.13

# Ollama ports
NODE1_OLLAMA_PORT=11434
NODE2_OLLAMA_PORT=11434
NODE3_OLLAMA_PORT=11435

# Exo port
EXO_PORT=5678

# Grafana
GRAFANA_ADMIN_PASSWORD=changeme

# Timezone
TZ=Asia/Bangkok
